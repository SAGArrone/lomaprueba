<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ar_rg5329" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n.ar.rg5329</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="RG 5329" name="l10n_ar_rg5329_perception">
                    <block title="Localización Argentina - Percepción IVA RG 5329/2023">
                        <setting
                            string="Percepción IVA RG 5329/2023"
                            help="Habilita el régimen de percepción de IVA RG 5329/2023 para bienes alcanzados.">
                            <field name="l10n_ar_rg5329_enabled"/>
                        </setting>

                        <setting
                            string="Cuenta contable"
                            help="Cuenta de pasivo donde se registrará la percepción.">
                            <field name="l10n_ar_rg5329_account_id"/>
                        </setting>

                        <setting
                            string="Grupo de impuestos"
                            help="Grupo fiscal que se utilizará para los impuestos de percepción RG 5329.">
                            <field name="l10n_ar_rg5329_tax_group_id"/>
                        </setting>

                        <setting
                            string="Importe mínimo"
                            help="La percepción sólo aplica si el importe calculado supera este mínimo.">
                            <field name="l10n_ar_rg5329_min_amount"/>
                        </setting>

                        <setting
                            string="Tipos de contribuyentes alcanzados"
                            help="Por defecto debe utilizarse Responsable Inscripto.">
                            <field name="l10n_ar_rg5329_responsibility_type_ids" widget="many2many_tags"/>
                        </setting>

                        <setting
                            string="Categorías alcanzadas"
                            help="Si no se seleccionan categorías, el régimen considera todos los productos.">
                            <field name="l10n_ar_rg5329_product_categ_ids" widget="many2many_tags"/>
                        </setting>

                        <setting
                            string="Actualizar productos"
                            help="Asocia o corrige los impuestos RG 5329 en los productos según categoría e IVA.">
                            <button
                                name="action_l10n_ar_rg5329_sync_products"
                                type="object"
                                string="Asociar impuestos RG 5329"
                                class="btn-secondary"
                                invisible="not l10n_ar_rg5329_enabled"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
