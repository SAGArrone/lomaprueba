<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ar_rg5329_v5" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n.ar.rg5329.v5</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Localizacion Argentina - Percepcion IVA RG 5329/2023" name="l10n_ar_rg5329_block_v5">
                    <setting
                        id="l10n_ar_rg5329_setting_v5"
                        string="Percepcion IVA RG 5329/2023"
                        help="Calcula automaticamente la percepcion por acumulado de factura y alicuota de IVA.">
                        <field name="l10n_ar_rg5329_enabled"/>
                    </setting>

                    <setting string="Cuenta contable" help="Cuenta de pasivo fiscal donde se registrara la percepcion.">
                        <field name="l10n_ar_rg5329_account_id" required="l10n_ar_rg5329_enabled" options="{'no_create_edit': False}"/>
                    </setting>

                    <setting string="Grupo de impuestos" help="Grupo fiscal que se usara para los impuestos de percepcion RG 5329.">
                        <field name="l10n_ar_rg5329_tax_group_id" required="l10n_ar_rg5329_enabled" options="{'no_create_edit': False}"/>
                    </setting>

                    <setting string="Importe minimo" help="La percepcion aplica si el importe calculado sobre la base acumulada supera este minimo.">
                        <field name="l10n_ar_rg5329_min_amount"/>
                    </setting>

                    <setting string="Tipos de contribuyentes alcanzados" help="Por defecto debe utilizarse Responsable Inscripto.">
                        <field name="l10n_ar_rg5329_responsibility_type_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </setting>

                    <setting string="Categorias alcanzadas" help="Si no se seleccionan categorias, se consideran todos los productos.">
                        <field name="l10n_ar_rg5329_product_categ_ids" widget="many2many_tags" options="{'no_create_edit': False}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
